{
  "permissions": {
    "allow": [
      "Bash(bash scripts/session-start.sh)",
      "Bash(scripts/session-start.sh)",
      "Bash(backlog:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash \"$CLAUDE_PROJECT_DIR/scripts/session-start.sh\""
          }
        ],
        "matcher": "^(startup|clear)$"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "for p in python3 python \"py -3\"; do $p -c \"import sys; sys.exit(sys.version_info[0] < 3)\" 2>/dev/null && { $p \"$CLAUDE_PROJECT_DIR/scripts/context-check.py\" 2>/dev/null; break; }; done; true"
          }
        ]
      }
    ]
  }
}
