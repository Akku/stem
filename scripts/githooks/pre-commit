#!/usr/bin/env bash
# Blocks source documents and local databases from being committed (they may be confidential).
# All checks cover added, modified, renamed and copied files (diff-filter AMRC), so a rename cannot bypass them.
bad=$(git diff --cached --name-only --diff-filter=AMRC | grep -i -E '\.(docx|pptx|xlsx|pdf|db|db-shm|db-wal|sqlite)$' || true)
if [ -n "$bad" ]; then
  echo "pre-commit: refusing to commit source documents / databases:" >&2
  echo "$bad" | sed 's/^/  /' >&2
  echo "Keep them in the ignored inputs folder. Override only deliberately: git commit --no-verify" >&2
  exit 1
fi

# Done tasks must have all boxes checked and finished dependencies; only staged task files are checked.
# Task file names contain spaces, so paths are passed NUL-separated.
tasks=()
while IFS= read -r -d '' f; do
  case "$f" in backlog/tasks/*.md) tasks+=("$f") ;; esac
done < <(git diff --cached --name-only --diff-filter=AMRC -z)
if [ ${#tasks[@]} -gt 0 ]; then
  if ! out=$(scripts/check-backlog.sh "${tasks[@]}" 2>&1); then
    echo "pre-commit: backlog check failed:" >&2
    echo "$out" | sed 's/^/  /' >&2
    echo "Finish the task (check the boxes or move open work into a follow-up task and say so in the notes) or keep it In Progress." >&2
    exit 1
  fi
fi

# Secret scan: .env files and added lines that look like credentials (high-confidence patterns only).
# Prints file names, never the matched text. Override deliberately: git commit --no-verify
pat='-----BEGIN [A-Z ]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{20,}|(^|[^A-Za-z0-9])sk-(ant-)?[A-Za-z0-9_-]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{35}|[rs]k_live_[A-Za-z0-9]{20,}'
leaks=()
while IFS= read -r -d '' f; do
  case "$f" in
    *.env.example|*.env.sample|*.env.template) continue ;;
    .env|*/.env|.env.*|*/.env.*|*.env|.envrc|*/.envrc) leaks+=("$f (environment file)"); continue ;;
  esac
  if git diff --cached -U0 --no-color -- "$f" | grep -E '^\+[^+]' | grep -E -q -e "$pat"; then leaks+=("$f (looks like a credential)"); fi
done < <(git diff --cached --name-only --diff-filter=AMRC -z)
if [ ${#leaks[@]} -gt 0 ]; then
  echo "pre-commit: possible secrets, refusing to commit:" >&2
  printf '  %s\n' "${leaks[@]}" >&2
  echo "Remove the secret (and rotate it if it was ever pushed). Override only deliberately: git commit --no-verify" >&2
  exit 1
fi
