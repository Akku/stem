#!/usr/bin/env bash
# While an unattended Tron run holds docs/agent/tron/LOCK (live pid), only the run itself (STEM_TRON_RUN set) commits on its tron/* branch;
# repairs wait until the run has stopped, so they never fall into a task's commit range.
lock=docs/agent/tron/LOCK
branch=$(git symbolic-ref -q --short HEAD || true)
if [ -f "$lock" ] && [ -z "${STEM_TRON_RUN:-}" ] && [[ $branch == tron/* ]]; then
  pid=$(tr -dc 0-9 < "$lock")
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    echo "pre-commit: an unattended run (pid $pid) is working on $branch; commit after it stopped (create docs/agent/tron/STOP to stop it)." >&2
    exit 1
  fi
fi

# Blocks source documents and local databases from being committed (they may be confidential).
# All checks cover added, modified, renamed and copied files (diff-filter AMRC), so a rename cannot bypass them.
bad=$(git diff --cached --name-only --diff-filter=AMRC | grep -i -E '\.(docx|pptx|xlsx|pdf|db|db-shm|db-wal|sqlite)$' || true)
if [ -n "$bad" ]; then
  echo "pre-commit: refusing to commit source documents / databases:" >&2
  echo "$bad" | sed 's/^/  /' >&2
  echo "Keep them in the ignored inputs folder. Override only deliberately: git commit --no-verify" >&2
  exit 1
fi

# Done tasks must have all boxes checked and finished dependencies; only staged task files are checked.
# Task file names contain spaces, so paths are passed NUL-separated.
tasks=()
while IFS= read -r -d '' f; do
  case "$f" in backlog/tasks/*.md) tasks+=("$f") ;; esac
done < <(git diff --cached --name-only --diff-filter=AMRC -z)
if [ ${#tasks[@]} -gt 0 ]; then
  if ! out=$(scripts/check-backlog.sh "${tasks[@]}" 2>&1); then
    echo "pre-commit: backlog check failed:" >&2
    echo "$out" | sed 's/^/  /' >&2
    echo "Finish the task (check the boxes or move open work into a follow-up task and say so in the notes) or keep it In Progress." >&2
    exit 1
  fi
fi

# A task that is newly set to Done needs a filled Outcome line (R-LIFECYCLE 1.6): its last Outcome line must not say 'pending'; tasks already Done are not checked.
# Paths are NUL-separated because task file names contain spaces.
noout=()
for f in "${tasks[@]}"; do
  [ -f "$f" ] || continue
  if git diff --cached -U0 --no-color -- "$f" | grep -q -E '^\+status: Done[[:space:]]*$' \
     && { ! git show ":$f" | grep -q -E '^Outcome:' || [ "$(git show ":$f" | grep -E '^Outcome:' | tail -1 | grep -ci 'pending')" -gt 0 ]; }; then noout+=("$f"); fi
done
if [ ${#noout[@]} -gt 0 ]; then
  echo "pre-commit: task set to Done without a filled Outcome line (missing or 'pending'):" >&2
  printf '  %s\n' "${noout[@]}" >&2
  echo "Add a notes line 'Outcome: corrections=N rework=Nmin defects=N' (or 'Outcome: unknown'); replace 'pending' with the measured values." >&2
  exit 1
fi

# TASK-312: a task newly set to Done needs verify evidence in its notes: a line with a PASS result (e.g. 'run.sh <label> PASS <log>') or a 'user-accepted:' line.
noev=()
for f in "${tasks[@]}"; do
  [ -f "$f" ] || continue
  if git diff --cached -U0 --no-color -- "$f" | grep -q -E '^\+status: Done[[:space:]]*$' \
     && ! git show ":$f" | grep -q -E 'PASS|^[[:space:]]*user-accepted:'; then noev+=("$f"); fi
done
if [ ${#noev[@]} -gt 0 ]; then
  echo "pre-commit: task set to Done without verify evidence (no PASS line and no 'user-accepted:' line in the notes):" >&2
  printf '  %s\n' "${noev[@]}" >&2
  echo "Run the verification via scripts/run.sh and note its PASS result, or record 'user-accepted: <what the user accepted>'." >&2
  exit 1
fi

# Retro 2026-11-22 (R-REVIEW): a newly added script (scripts/, not scripts/local) edits files and must not be closed with a review waiver; a Done task with a waiver line but no independent review line is refused while such a script is staged.
if git diff --cached --name-only --diff-filter=A | grep -q -E '^scripts/[^/]+\.(py|sh)$'; then
  norev=()
  for f in "${tasks[@]}"; do
    [ -f "$f" ] || continue
    if git diff --cached -U0 --no-color -- "$f" | grep -q -E '^\+status: Done[[:space:]]*$' \
       && git show ":$f" | grep -q -i -E 'waive' && ! git show ":$f" | grep -q -i -E 'independent .*subagent|^Review \(independent'; then norev+=("$f"); fi
  done
  if [ ${#norev[@]} -gt 0 ]; then
    echo "pre-commit: a new script is staged and these tasks are Done with a review waiver but no independent review (R-REVIEW: a new script that edits files needs one):" >&2
    printf '  %s\n' "${norev[@]}" >&2
    echo "Run an independent review and note a line 'Review (independent ...)', or move the script commit out of this task." >&2
    exit 1
  fi
fi

# Secret scan: .env files and added lines that look like credentials (high-confidence patterns only).
# Prints file names, never the matched text. Override deliberately: git commit --no-verify
pat='-----BEGIN [A-Z ]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{20,}|(^|[^A-Za-z0-9])sk-(ant-)?[A-Za-z0-9_-]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{35}|[rs]k_live_[A-Za-z0-9]{20,}'
leaks=()
while IFS= read -r -d '' f; do
  case "$f" in
    *.env.example|*.env.sample|*.env.template) continue ;;
    .env|*/.env|.env.*|*/.env.*|*.env|.envrc|*/.envrc) leaks+=("$f (environment file)"); continue ;;
  esac
  if git diff --cached -U0 --no-color -- "$f" | grep -E '^\+[^+]' | grep -E -q -e "$pat"; then leaks+=("$f (looks like a credential)"); fi
done < <(git diff --cached --name-only --diff-filter=AMRC -z)
if [ ${#leaks[@]} -gt 0 ]; then
  echo "pre-commit: possible secrets, refusing to commit:" >&2
  printf '  %s\n' "${leaks[@]}" >&2
  echo "Remove the secret (and rotate it if it was ever pushed). Override only deliberately: git commit --no-verify" >&2
  exit 1
fi
