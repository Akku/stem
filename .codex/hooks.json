{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|clear)$",
        "hooks": [
          {
            "type": "command",
            "command": "root=\"$(git rev-parse --show-toplevel)\" && cd \"$root\" && bash scripts/session-start.sh"
          }
        ]
      }
    ]
  }
}
